# Build output
/build/
/archive/
*.txz
*.txz.md5
*.tgz

# PHP tooling
/vendor/
composer.lock
.phpunit.result.cache

# Node tooling (for the client-side YAML / form bundle)
/node_modules/
/dist/
*.tsbuildinfo

# Editors / OS
.vscode/*
!.vscode/settings.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Local scratch — never commit server dumps or captured configs
/scratch/
/local/
*.local

# Review artifacts — kept locally for comparison, not part of the source
/audits/

# Finished plans — kept on disk for reference, not carried in the repository
/completed-plans/

# Working plans — kept on disk while a piece is being built, not carried in the repository
/PLAN.md
/PLAN_*.md

# Project review reports, written by the order95 skill. Derived entirely from the plans
# and the code, and the plans themselves are not in the repository either — so a report
# carried here would reference files a clone does not have.
/summaries/

# The running list of things to check on screen — a working note that changes with
# whatever was built that day, and is finished with once it has been walked through.
/MANUAL-TESTS.md

# Local Claude Code setup. .claude/ holds the feedlog skill, and that skill
# carries the access token for Adrian's own feedback board — so this is
# credential hygiene, not just tidiness. The board is also unreachable for
# anyone cloning this plugin, so there is nothing here worth carrying.
#
# .mcp.json no longer exists: the board was reached through an MCP server
# once, and is now a skill talking straight to it. The rule stays as a guard,
# so a config file holding a token cannot be committed by accident if that
# approach ever returns.
/.claude/
/.mcp.json
