#!/bin/bash
# Stack Manager — post-save hook, run by /update.php after the config is written.
#
# The .page Cond expressions that decide where the Stacks view appears are
# evaluated on every page render, for every page. Parsing an ini file there
# would be wasteful, and quoting a config lookup inside a .page ini header is
# fragile. So the config is projected onto a marker file once, here, and the
# Cond expressions do a single file_exists() instead.
#
# Copyright 2026, Stack Manager contributors. GPL-2.0.

set -euo pipefail

PLUGIN="stack.manager"
CFG_DIR="/boot/config/plugins/${PLUGIN}"
CFG="${CFG_DIR}/${PLUGIN}.cfg"
MARKER="${CFG_DIR}/header_menu"

mkdir -p "${CFG_DIR}"

header_menu="false"
if [[ -f "${CFG}" ]]; then
  # Values may or may not be quoted; strip quotes and surrounding whitespace.
  header_menu=$(sed -n 's/^[[:space:]]*HEADER_MENU[[:space:]]*=[[:space:]]*"\?\([^"]*\)"\?[[:space:]]*$/\1/p' "${CFG}" | tail -n1)
  header_menu="${header_menu:-false}"
fi

if [[ "${header_menu}" == "true" ]]; then
  touch "${MARKER}"
else
  rm -f "${MARKER}"
fi

# Stack directory must exist before anything tries to enumerate it.
stack_root=$(sed -n 's/^[[:space:]]*STACK_ROOT[[:space:]]*=[[:space:]]*"\?\([^"]*\)"\?[[:space:]]*$/\1/p' "${CFG}" 2>/dev/null | tail -n1 || true)
if [[ -n "${stack_root}" ]]; then
  mkdir -p "${stack_root}"
fi

echo "Stack Manager settings applied."
