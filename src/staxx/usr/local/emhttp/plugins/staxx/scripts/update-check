#!/bin/bash
# StaXX — scheduled image-update passes, run from the cron entry apply_settings
# writes to /boot/config/plugins/staxx/staxx.cron.
#
# cron's environment is barer than a web request's: no PATH worth trusting, no
# working directory, nobody watching stderr. Everything here is written for
# that — explicit paths, a log instead of a terminal, and a guard for Docker
# not being up yet.
#
# Copyright 2026, StaXX contributors. GPL-2.0.

set -euo pipefail

PLUGIN_DIR="/usr/local/emhttp/plugins/staxx"
CFG="/boot/config/plugins/staxx/staxx.cfg"
LOG_DIR="/tmp/staxx/updates"

# Allowlisted before anything else touches the filesystem. LOG below is built
# straight from this argument, and building it before this check meant
# `update-check ../../../etc/foo` truncated that file rather than a log of
# ours. Root-only and the cron entries always pass one of these three fixed
# words, so this is hygiene rather than a live vulnerability — but the order
# still matters.
case "${1:-}" in
  check|apply|cleanup) ;;
  *)
    echo "Usage: update-check {check|apply|cleanup}" >&2
    exit 1
    ;;
esac

# One log per pass, not one shared file: the apply pass now runs every 15
# minutes, and a single log truncated on every run would wipe out a daily
# check pass's own output within the same quarter hour.
LOG="${LOG_DIR}/update-$1.log"

mkdir -p "${LOG_DIR}"
chmod 0755 "${LOG_DIR}"

# Overwrite rather than append: each pass runs unattended for a long time, and
# only its own most recent run is ever worth reading — see the job logs and
# the stats snapshots for the same call.
: > "${LOG}"

log() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "${LOG}"
}

# One pass at a time, same atomic-mkdir idiom as stats-collector.sh's lock —
# without it, two passes (a cron tick landing on top of a manual run, say)
# could run over the same queue at once, and the second pass's `: >` above
# would already have wiped the first's log mid-flight even before this. A
# lock younger than five minutes belongs to a pass still running (every pass
# here finishes in seconds — the compose work itself runs as a detached job,
# not inside this script); anything older is abandoned and reclaimed.
LOCKDIR="${LOG_DIR}/update.lock"
if ! mkdir "${LOCKDIR}" 2>/dev/null; then
  age=$(( $(date +%s) - $(stat -c %Y "${LOCKDIR}" 2>/dev/null || echo 0) ))
  if [[ ${age} -lt 300 ]]; then
    log "another update-check pass is already running; skipping."
    exit 0
  fi
  rm -rf "${LOCKDIR}"          # stale: whatever held it is long gone
  mkdir "${LOCKDIR}" 2>/dev/null || { log "could not take the update lock; skipping."; exit 0; }
fi
trap 'rmdir "${LOCKDIR}" 2>/dev/null' EXIT INT TERM

# Resolved explicitly rather than trusted from PATH — cron's PATH is often
# just /usr/bin:/bin, but is not guaranteed to hold php at all.
php_bin=""
for candidate in /usr/bin/php /usr/local/bin/php; do
  if [[ -x "${candidate}" ]]; then
    php_bin="${candidate}"
    break
  fi
done
php_bin="${php_bin:-php}"

run_check() {
  # Belt and braces: the cron entry should not exist at all when checking is
  # off, but a stale entry surviving a failed rewrite must not then run a pass
  # the user turned off.
  update_check="daily"
  if [[ -f "${CFG}" ]]; then
    update_check=$(sed -n 's/^[[:space:]]*UPDATE_CHECK[[:space:]]*=[[:space:]]*"\?\([^"]*\)"\?[[:space:]]*$/\1/p' "${CFG}" | tail -n1)
    update_check="${update_check:-daily}"
  fi

  if [[ "${update_check}" == "off" ]]; then
    log "update check is off; nothing to do."
    exit 0
  fi

  if ! command -v docker >/dev/null 2>&1 || ! timeout -k 2 10 docker info >/dev/null 2>&1; then
    # A cron job firing before Docker is up on boot is not an error.
    log "Docker is not available; skipping this pass."
    exit 0
  fi

  log "starting check pass (UPDATE_CHECK=${update_check})."
  # false = a scheduled pass respects the remembered six-hour answers; only a
  # person pressing the button in the browser forces every image to be asked
  # again.
  "${php_bin}" -r "require '${PLUGIN_DIR}/include/Updates.php'; staxx_update_check('all', false);" >> "${LOG}" 2>&1
  log "check pass finished."
}

run_apply() {
  if ! command -v docker >/dev/null 2>&1 || ! timeout -k 2 10 docker info >/dev/null 2>&1; then
    # A cron job firing before Docker is up on boot is not an error.
    log "Docker is not available; skipping this pass."
    exit 0
  fi

  log "starting apply pass."
  # staxx_update_apply_pass() ticks a running queue along, or starts a fresh
  # one over whatever staxx_update_due() has found — either way it costs no
  # network, which is why this runs every 15 minutes rather than daily.
  "${php_bin}" -r "
    require '${PLUGIN_DIR}/include/UpdateRun.php';
    \$r = staxx_update_apply_pass();
    \$n = count(\$r['items'] ?? []);
    echo \$n.' item'.(\$n === 1 ? '' : 's').' in the queue.'.PHP_EOL;
  " >> "${LOG}" 2>&1
  log "apply pass finished."
}

run_cleanup() {
  if ! command -v docker >/dev/null 2>&1 || ! timeout -k 2 10 docker info >/dev/null 2>&1; then
    log "Docker is not available; skipping this pass."
    exit 0
  fi

  log "starting cleanup pass."
  "${php_bin}" -r "
    require '${PLUGIN_DIR}/include/UpdateRun.php';
    \$err = '';
    \$r = staxx_update_cleanup(false, \$err);
    if (\$err !== '') echo 'cleanup refused: '.\$err.PHP_EOL;
    echo count(\$r['removed']).' image'.(count(\$r['removed']) === 1 ? '' : 's').' removed, '
       . \$r['kept'].' kept.'.PHP_EOL;
    foreach (\$r['removed'] as \$ref) echo '  removed '.\$ref.PHP_EOL;
  " >> "${LOG}" 2>&1
  log "cleanup pass finished."
}

case "${1:-}" in
  check)
    run_check
    ;;
  apply)
    run_apply
    ;;
  cleanup)
    run_cleanup
    ;;
  *)
    echo "Usage: update-check {check|apply|cleanup}" >&2
    exit 1
    ;;
esac
