#!/bin/bash
# StaXX — post-save hook, run by /update.php after the config is written.
#
# The .page Cond expressions that decide where the Stacks view appears are
# evaluated on every page render, for every page. Parsing an ini file there
# would be wasteful, and quoting a config lookup inside a .page ini header is
# fragile. So the config is projected onto a marker file once, here, and the
# Cond expressions do a single file_exists() instead.
#
# Copyright 2026, StaXX contributors. GPL-2.0.

set -euo pipefail

PLUGIN="staxx"
CFG_DIR="/boot/config/plugins/${PLUGIN}"
CFG="${CFG_DIR}/${PLUGIN}.cfg"
MARKER="${CFG_DIR}/header_menu"
TAKEOVER_MARKER="${CFG_DIR}/takeover_docker_tab"
HUB_LOGIN_MARKER="${CFG_DIR}/hub_login"
PLUGIN_DIR="/usr/local/emhttp/plugins/${PLUGIN}"

mkdir -p "${CFG_DIR}"

header_menu="false"
if [[ -f "${CFG}" ]]; then
  # Values may or may not be quoted; strip quotes and surrounding whitespace.
  header_menu=$(sed -n 's/^[[:space:]]*HEADER_MENU[[:space:]]*=[[:space:]]*"\?\([^"]*\)"\?[[:space:]]*$/\1/p' "${CFG}" | tail -n1)
  header_menu="${header_menu:-false}"
fi

if [[ "${header_menu}" == "true" ]]; then
  touch "${MARKER}"
else
  rm -f "${MARKER}"
fi

# Docker.page replaces Unraid's stock Docker top-nav button (PageBuilder keys
# pages by bare filename and the last plugin folder alphabetically wins, which
# is us). The live copy is made from a dormant template — see shadow/ — only
# while the setting is on; otherwise it is removed and the stock button, and
# everything under it, reappears untouched.
takeover_docker_tab="false"
if [[ -f "${CFG}" ]]; then
  takeover_docker_tab=$(sed -n 's/^[[:space:]]*TAKEOVER_DOCKER_TAB[[:space:]]*=[[:space:]]*"\?\([^"]*\)"\?[[:space:]]*$/\1/p' "${CFG}" | tail -n1)
  takeover_docker_tab="${takeover_docker_tab:-false}"
fi

# Projected onto a marker file for the same reason HEADER_MENU is: StaXX.page's
# Cond has to know about this, and Cond runs on every render of every page. It
# matters because removing the Docker button takes our own Docker sub-tab down
# with it — so without this, turning the takeover on with HEADER_MENU off would
# leave no way into StaXX at all.
if [[ "${takeover_docker_tab}" == "true" ]]; then
  touch "${TAKEOVER_MARKER}"
else
  rm -f "${TAKEOVER_MARKER}"
fi

# The plugin folder may not exist yet the first time this runs during install
# ordering; skip quietly rather than fail; there is nothing to shadow into yet.
if [[ -d "${PLUGIN_DIR}" ]]; then
  docker_tab_live="${PLUGIN_DIR}/Docker.page"
  docker_tab_shadow="${PLUGIN_DIR}/shadow/Docker.page.tmpl"
  if [[ "${takeover_docker_tab}" == "true" ]]; then
    if [[ ! -f "${docker_tab_shadow}" ]]; then
      echo "error: ${docker_tab_shadow} is missing, so the Docker menu cannot be taken over." >&2
      exit 1
    fi
    cp "${docker_tab_shadow}" "${docker_tab_live}"
  else
    rm -f "${docker_tab_live}"
  fi
fi

# Stack directory must exist before anything tries to enumerate it.
stack_root=$(sed -n 's/^[[:space:]]*STACK_ROOT[[:space:]]*=[[:space:]]*"\?\([^"]*\)"\?[[:space:]]*$/\1/p' "${CFG}" 2>/dev/null | tail -n1 || true)
if [[ -n "${stack_root}" ]]; then
  mkdir -p "${stack_root}"
fi

# Docker Hub sign-in, so image-update checking does not run into Docker Hub's
# rate limit (roughly ten questions an hour signed out, a hundred signed in).
# Runs on every settings save AND on every boot (install re-runs this), so it
# has to survive Docker not being up yet: nothing here may abort the script,
# because a settings save must succeed even while Docker is still starting.
hub_user=""
hub_token=""
if [[ -f "${CFG}" ]]; then
  hub_user=$(sed -n 's/^[[:space:]]*HUB_USER[[:space:]]*=[[:space:]]*"\?\([^"]*\)"\?[[:space:]]*$/\1/p' "${CFG}" | tail -n1)
  hub_token=$(sed -n 's/^[[:space:]]*HUB_TOKEN[[:space:]]*=[[:space:]]*"\?\([^"]*\)"\?[[:space:]]*$/\1/p' "${CFG}" | tail -n1)
fi

if ! command -v docker >/dev/null 2>&1 || ! docker info >/dev/null 2>&1; then
  # Docker not up yet: leave the marker exactly as it is, so nothing is lost
  # and the next save (or the boot's own retry) picks up where this left off.
  # Only worth saying to someone who actually configured a sign-in; on every
  # other box this branch is the normal case and a line here would be noise.
  if [[ -n "${hub_user}" && -n "${hub_token}" ]]; then
    echo "Docker is not available yet, so the Docker Hub sign-in will be applied the next time settings are saved."
  fi
elif [[ -n "${hub_user}" && -n "${hub_token}" ]]; then
  # The token goes in on stdin, never as an argument — an argument sits in
  # plain view of every user on the box via "ps". "|| true" so a bad token
  # or a network hiccup does not fail the whole settings save.
  if printf '%s' "${hub_token}" | docker login --username "${hub_user}" --password-stdin >/dev/null 2>&1; then
    touch "${HUB_LOGIN_MARKER}"
    echo "Signed in to Docker Hub as ${hub_user}."
  else
    echo "Docker Hub sign-in was refused; check the username and token in Settings."
  fi
elif [[ -f "${HUB_LOGIN_MARKER}" ]]; then
  # Only ever sign out a sign-in this plugin itself performed — never an
  # administrator's own Docker Hub session from outside StaXX.
  docker logout >/dev/null 2>&1 || true
  rm -f "${HUB_LOGIN_MARKER}"
  echo "Signed out of Docker Hub."
fi

echo "StaXX settings applied."
