#!/bin/bash
# StaXX — post-save hook, run by /update.php after the config is written.
#
# The .page Cond expressions that decide where the Stacks view appears are
# evaluated on every page render, for every page. Parsing an ini file there
# would be wasteful, and quoting a config lookup inside a .page ini header is
# fragile. So the config is projected onto a marker file once, here, and the
# Cond expressions do a single file_exists() instead.
#
# Copyright 2026, StaXX contributors. GPL-2.0.

set -euo pipefail

PLUGIN="staxx"
CFG_DIR="/boot/config/plugins/${PLUGIN}"
CFG="${CFG_DIR}/${PLUGIN}.cfg"
MARKER="${CFG_DIR}/header_menu"
TAKEOVER_MARKER="${CFG_DIR}/takeover_docker_tab"
HUB_LOGIN_MARKER="${CFG_DIR}/hub_login"
PLUGIN_DIR="/usr/local/emhttp/plugins/${PLUGIN}"

mkdir -p "${CFG_DIR}"

header_menu="false"
if [[ -f "${CFG}" ]]; then
  # Values may or may not be quoted; strip quotes and surrounding whitespace.
  header_menu=$(sed -n 's/^[[:space:]]*HEADER_MENU[[:space:]]*=[[:space:]]*"\?\([^"]*\)"\?[[:space:]]*$/\1/p' "${CFG}" | tail -n1)
  header_menu="${header_menu:-false}"
fi

if [[ "${header_menu}" == "true" ]]; then
  touch "${MARKER}"
else
  rm -f "${MARKER}"
fi

# Docker.page replaces Unraid's stock Docker top-nav button (PageBuilder keys
# pages by bare filename and the last plugin folder alphabetically wins, which
# is us). The live copy is made from a dormant template — see shadow/ — only
# while the setting is on; otherwise it is removed and the stock button, and
# everything under it, reappears untouched.
takeover_docker_tab="false"
if [[ -f "${CFG}" ]]; then
  takeover_docker_tab=$(sed -n 's/^[[:space:]]*TAKEOVER_DOCKER_TAB[[:space:]]*=[[:space:]]*"\?\([^"]*\)"\?[[:space:]]*$/\1/p' "${CFG}" | tail -n1)
  takeover_docker_tab="${takeover_docker_tab:-false}"
fi

# Projected onto a marker file for the same reason HEADER_MENU is: StaXX.page's
# Cond has to know about this, and Cond runs on every render of every page. It
# matters because removing the Docker button takes our own Docker sub-tab down
# with it — so without this, turning the takeover on with HEADER_MENU off would
# leave no way into StaXX at all.
if [[ "${takeover_docker_tab}" == "true" ]]; then
  touch "${TAKEOVER_MARKER}"
else
  rm -f "${TAKEOVER_MARKER}"
fi

# PLAN_97 Phase 4: STORE_ROOT, HEADER_MENU and TAKEOVER_DOCKER_TAB are the
# only three keys left in the flash file — everything else this script reads
# below now lives in the store's own config file, because that is where the
# rest of the settings moved. STORE_ROOT itself has to stay on flash: you
# cannot read the house's address from inside the house.
store_root=$(sed -n 's/^[[:space:]]*STORE_ROOT[[:space:]]*=[[:space:]]*"\?\([^"]*\)"\?[[:space:]]*$/\1/p' "${CFG}" 2>/dev/null | tail -n1 || true)

# The store's two fixed-name folders must exist before anything tries to
# enumerate them — but only once the store itself is actually there. A pool
# that has not mounted yet still shows its mountpoint as an ordinary empty
# directory, so testing for the store root itself (rather than just a
# non-blank setting) stops this from creating a phantom copy of the tree on
# the root filesystem underneath an unmounted pool, which a real mount would
# then silently hide behind.
if [[ -n "${store_root}" && -d "${store_root}" ]]; then
  mkdir -p "${store_root}/stacks" "${store_root}/archives"
fi

# Everything below this line that used to read "${CFG}" now reads the store's
# own config file instead. This script re-runs on every boot, which is
# exactly when a store on a pool may not have mounted yet — reading a missing
# file as blank and then acting on that (deleting the install-catching shadow
# page, signing out of Docker Hub, rewriting the cron schedule to shipped
# defaults) would silently undo somebody's settings on every reboot. So a
# store that cannot be read right now is treated the same way "Docker is not
# up yet" already is further down: skip the section and leave whatever is on
# disk exactly as it is, and never abort — a settings save has to succeed
# even mid-boot.
store_cfg=""
store_cfg_readable="false"
if [[ -n "${store_root}" && -f "${store_root}/config/${PLUGIN}.cfg" ]]; then
  store_cfg="${store_root}/config/${PLUGIN}.cfg"
  store_cfg_readable="true"
fi

# Whether Add Container installs from Unraid's Apps page (and Add Container
# pressed by hand) are caught and brought into StaXX. Defaults true, unlike
# the two markers above, so a config predating this key still catches installs.
# Three values: true (catch silently), prompt (ask first — same shadow page,
# it decides what to show), false (Unraid's own route). The shadow is
# installed for true AND prompt, and removed only for false.
catch_installs="true"
if [[ "${store_cfg_readable}" == "true" ]]; then
  catch_installs=$(sed -n 's/^[[:space:]]*CATCH_INSTALLS[[:space:]]*=[[:space:]]*"\?\([^"]*\)"\?[[:space:]]*$/\1/p' "${store_cfg}" | tail -n1)
  catch_installs="${catch_installs:-true}"
fi

# The plugin folder may not exist yet the first time this runs during install
# ordering; skip quietly rather than fail; there is nothing to shadow into yet.
if [[ -d "${PLUGIN_DIR}" ]]; then
  docker_tab_live="${PLUGIN_DIR}/Docker.page"
  docker_tab_shadow="${PLUGIN_DIR}/shadow/Docker.page.tmpl"
  if [[ "${takeover_docker_tab}" == "true" ]]; then
    if [[ -f "${docker_tab_shadow}" ]]; then
      cp "${docker_tab_shadow}" "${docker_tab_live}"
    else
      # Never exit non-zero here: this script is run by the installer and after
      # every settings save, and under set -e a failure would fail the whole
      # install. Removing the live copy is the safe outcome — a stale one would
      # shadow the stock Docker button with a page whose template has gone.
      echo "warning: ${docker_tab_shadow} is missing, so the Docker menu was not taken over." >&2
      rm -f "${docker_tab_live}"
    fi
  else
    rm -f "${docker_tab_live}"
  fi

  # AddContainer.page has no marker file: nothing's .page Cond needs to know
  # about this setting, since the file being there at all is what does the
  # catching — same mechanism as Docker.page above, just with no Cond to feed.
  # CATCH_INSTALLS now lives in the store, so an unreadable store (see above)
  # must leave this file exactly as it is rather than reading the setting as
  # its default and cp'ing or rm'ing it out from under whatever is running.
  if [[ "${store_cfg_readable}" == "true" ]]; then
    add_container_live="${PLUGIN_DIR}/AddContainer.page"
    add_container_shadow="${PLUGIN_DIR}/shadow/AddContainer.page.tmpl"
    if [[ "${catch_installs}" == "true" || "${catch_installs}" == "prompt" ]]; then
      if [[ -f "${add_container_shadow}" ]]; then
        cp "${add_container_shadow}" "${add_container_live}"
      else
        echo "warning: ${add_container_shadow} is missing, so installs are not being caught." >&2
        rm -f "${add_container_live}"
      fi
    else
      rm -f "${add_container_live}"
    fi
  fi
fi

# Docker Hub sign-in, so image-update checking does not run into Docker Hub's
# rate limit (roughly ten questions an hour signed out, a hundred signed in).
# Runs on every settings save AND on every boot (install re-runs this), so it
# has to survive Docker not being up yet: nothing here may abort the script,
# because a settings save must succeed even while Docker is still starting.
# HUB_USER/HUB_TOKEN now live in the store, so an unreadable store gets the
# same treatment as Docker not being up: skip the whole decision rather than
# read the setting as blank and sign out a sign-in that is still configured.
hub_user=""
hub_token=""
if [[ "${store_cfg_readable}" == "true" ]]; then
  hub_user=$(sed -n 's/^[[:space:]]*HUB_USER[[:space:]]*=[[:space:]]*"\?\([^"]*\)"\?[[:space:]]*$/\1/p' "${store_cfg}" | tail -n1)
  hub_token=$(sed -n 's/^[[:space:]]*HUB_TOKEN[[:space:]]*=[[:space:]]*"\?\([^"]*\)"\?[[:space:]]*$/\1/p' "${store_cfg}" | tail -n1)
fi

if [[ "${store_cfg_readable}" != "true" ]]; then
  : # Store not reachable yet — leave the sign-in state exactly as it is.
elif ! command -v docker >/dev/null 2>&1 || ! timeout -k 2 10 docker info >/dev/null 2>&1; then
  # Docker not up yet: leave the marker exactly as it is, so nothing is lost
  # and the next save (or the boot's own retry) picks up where this left off.
  # Only worth saying to someone who actually configured a sign-in; on every
  # other box this branch is the normal case and a line here would be noise.
  if [[ -n "${hub_user}" && -n "${hub_token}" ]]; then
    echo "Docker is not available yet, so the Docker Hub sign-in will be applied the next time settings are saved."
  fi
elif [[ -n "${hub_user}" && -n "${hub_token}" ]]; then
  # The token goes in on stdin, never as an argument — an argument sits in
  # plain view of every user on the box via "ps". "|| true" so a bad token
  # or a network hiccup does not fail the whole settings save.
  if printf '%s' "${hub_token}" | timeout -k 2 10 docker login --username "${hub_user}" --password-stdin >/dev/null 2>&1; then
    touch "${HUB_LOGIN_MARKER}"
    echo "Signed in to Docker Hub as ${hub_user}."
  else
    echo "Docker Hub sign-in was refused; check the username and token in Settings."
  fi
elif [[ -f "${HUB_LOGIN_MARKER}" ]]; then
  # Only ever sign out a sign-in this plugin itself performed — never an
  # administrator's own Docker Hub session from outside StaXX.
  timeout -k 2 10 docker logout >/dev/null 2>&1 || true
  rm -f "${HUB_LOGIN_MARKER}"
  echo "Signed out of Docker Hub."
fi

# Image-update check schedule. Unraid's cron builder (update_cron) only reads
# *.cron files out of each installed plugin's own folder under
# /boot/config/plugins/ and concatenates them into root's single crontab —
# /etc/cron.d/staxx is never read, and gets clobbered by that rewrite anyway.
# So the file has to live on the flash drive, and — because that has finite
# write cycles and this script runs on every settings save AND every boot —
# only gets rewritten when its content actually changes.
#
# UPDATE_CHECK/UPDATE_CHECK_TIME/UPDATE_CLEANUP now live in the store. A store
# that has been chosen but cannot be read right now (pool not mounted yet)
# must not rewrite this file to shipped defaults — that would silently drop
# back to "daily at 04:00" every reboot until the pool catches up. Only a
# genuinely unchosen store (store_root blank) falls through to the defaults
# below, which matches today: there are no stacks to check either way.
skip_cron_rewrite="false"
update_check="daily"
update_check_time="04:00"
update_cleanup="off"
if [[ "${store_cfg_readable}" == "true" ]]; then
  update_check=$(sed -n 's/^[[:space:]]*UPDATE_CHECK[[:space:]]*=[[:space:]]*"\?\([^"]*\)"\?[[:space:]]*$/\1/p' "${store_cfg}" | tail -n1)
  update_check="${update_check:-daily}"
  update_check_time=$(sed -n 's/^[[:space:]]*UPDATE_CHECK_TIME[[:space:]]*=[[:space:]]*"\?\([^"]*\)"\?[[:space:]]*$/\1/p' "${store_cfg}" | tail -n1)
  update_check_time="${update_check_time:-04:00}"
  update_cleanup=$(sed -n 's/^[[:space:]]*UPDATE_CLEANUP[[:space:]]*=[[:space:]]*"\?\([^"]*\)"\?[[:space:]]*$/\1/p' "${store_cfg}" | tail -n1)
  update_cleanup="${update_cleanup:-off}"
elif [[ -n "${store_root}" ]]; then
  skip_cron_rewrite="true"
  echo "The data store is not reachable yet, so the existing image-update schedule was left as it is."
fi

CRON_FILE="${CFG_DIR}/${PLUGIN}.cron"

if [[ "${skip_cron_rewrite}" != "true" ]]; then
  # No "root" user field on any line here — *.cron files are concatenated
  # straight into a user crontab by update_cron, not read as /etc/cron.d-style
  # system crontabs, so a leading user field would be read as part of the
  # command.
  #
  # The apply pass is always present, check on or off: it is what presses the
  # button on a clock that reaches zero while nobody has the page open, and it
  # costs no network, so there is nothing to gate it on.
  cron_lines=(
    "# StaXX — image-update passes, written by apply_settings. Do not edit; it is rewritten on every settings save and every boot."
    "*/15 * * * * ${PLUGIN_DIR}/scripts/update-check apply &> /dev/null"
  )

  if [[ "${update_check}" == "off" ]]; then
    echo "Image-update checking is off."
  else
    # HH:MM, range-checked (00-23 and 00-59), not just shape-checked — the
    # earlier pattern accepted "99:99" and would have written "99 99 * * *"
    # into a file update_cron concatenates into root's crontab alongside every
    # other plugin's jobs. A value that fails either check falls back to the
    # default rather than writing a malformed line — one bad line can make cron
    # reject the whole file, taking every other job on the box down with it.
    # Same pattern Settings.php already validates the setting with.
    if [[ "${update_check_time}" =~ ^([01][0-9]|2[0-3]):([0-5][0-9])$ ]]; then
      cron_hour="${BASH_REMATCH[1]}"
      cron_minute="${BASH_REMATCH[2]}"
    else
      cron_hour="04"
      cron_minute="00"
    fi
    # cron takes "4", not "04" — a leading zero on the minute in particular has
    # bitten people, so both are stripped explicitly rather than trusted to
    # whichever cron happens to be running this.
    cron_hour="${cron_hour#0}"
    cron_minute="${cron_minute#0}"
    cron_hour="${cron_hour:-0}"
    cron_minute="${cron_minute:-0}"

    if [[ "${update_check}" == "weekly" ]]; then
      cron_dow="0"       # Sunday
      when="weekly, Sunday at ${update_check_time}"
    else
      cron_dow="*"
      when="daily at ${update_check_time}"
    fi

    # The jitter minute is derived from a stable local value, never rand() or
    # $RANDOM: a minute that moves every boot makes the schedule unreadable,
    # and every StaXX install landing on the hour would look like a stampede
    # against the abuse limit Docker Hub applies to all traffic, free
    # questions included. /etc/machine-id is preferred because it is set once
    # at install and does not change on a rename; hostname is the fallback
    # for a system without it. 1-59 so it never lands on :00 either.
    if [[ -s /etc/machine-id ]]; then
      jitter_seed=$(md5sum /etc/machine-id | cut -c1-4)
    else
      jitter_seed=$(hostname | md5sum | cut -c1-4)
    fi
    jitter_minute=$(( 16#${jitter_seed} % 58 + 1 ))

    # Two lines, not one: an hourly pass that honours each image's own
    # cadence, plus the chosen time as a "full" pass that considers every
    # image regardless of cadence. The daily/weekly setting keeps its old
    # meaning of "how often everything is looked at", but individual images
    # can now be asked about more often than that — the guide says so.
    cron_lines+=("${jitter_minute} * * * * ${PLUGIN_DIR}/scripts/update-check check &> /dev/null")
    cron_lines+=("${cron_minute} ${cron_hour} * * ${cron_dow} ${PLUGIN_DIR}/scripts/update-check full &> /dev/null")
    echo "Image-update checking will run hourly (at :$(printf '%02d' "${jitter_minute}") past), with a full look at every image ${when}."
  fi

  if [[ "${update_cleanup}" == "weekly" ]]; then
    # A fixed, quiet time — this is not user-configurable the way the check
    # time is, so there is no value to read and validate here.
    cron_lines+=("30 3 * * 0 ${PLUGIN_DIR}/scripts/update-check cleanup &> /dev/null")
    echo "Image cleanup will run weekly, Sunday at 03:30."
  fi

  cron_content=$(printf '%s\n' "${cron_lines[@]}")

  # Compare before writing: the flash drive has finite write cycles, and this
  # script runs on every settings save and every boot.
  if [[ ! -f "${CRON_FILE}" ]] || [[ "$(cat "${CRON_FILE}")" != "${cron_content}" ]]; then
    printf '%s\n' "${cron_content}" > "${CRON_FILE}"
  fi
fi

# Collects every plugin's *.cron file (ours included) into root's crontab —
# guarded, because a settings save must succeed even if this is missing or fails.
if [[ -x /usr/local/sbin/update_cron ]]; then
  /usr/local/sbin/update_cron || true
fi

echo "StaXX settings applied."
