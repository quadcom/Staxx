<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name                 "staxx">
<!ENTITY author               "Quadcom">
<!ENTITY version              "2026.08.26">
<!ENTITY launch               "Settings/&name;.settings">

<!-- TODO: point at the real repository before the first release. Left as an
     obvious placeholder so a premature publish fails loudly rather than
     silently fetching from somewhere unintended. -->
<!ENTITY github               "quadcom/Staxx">
<!ENTITY branch               "main">

<!ENTITY pkgARCH              "noarch">
<!ENTITY pkgBUILD             "1">
<!ENTITY packageName          "&name;-&version;-&pkgARCH;-&pkgBUILD;">
<!ENTITY packageFile          "&packageName;.txz">
<!ENTITY packageMD5           "TODO-MD5">
<!ENTITY packageSHA256        "TODO-SHA256">

<!ENTITY pluginURL            "https://raw.githubusercontent.com/&github;/&branch;/&name;.plg">
<!ENTITY packageURL           "https://github.com/&github;/releases/download/v&version;/&packageFile;">

<!ENTITY pluginsPATH          "/boot/config/plugins">
<!ENTITY pluginLOC            "&pluginsPATH;/&name;">
<!ENTITY emhttpPATH           "/usr/local/emhttp/plugins">
<!ENTITY emhttpLOC            "&emhttpPATH;/&name;">
]>

<PLUGIN  name="&name;"
         author="&author;"
         version="&version;"
         launch="&launch;"
         pluginURL="&pluginURL;"
         icon="cubes"
         min="7.2.0"
         support="https://staxxfb.quadcom.ca"
         project="https://github.com/&github;"
         readme="https://github.com/&github;#readme"
>

<CHANGES>
###2026.08.26
- A stack now records its own icon beside its compose file, so it keeps its look when copied
  to another machine. The editor shows each service's icon where you choose it.
- A password can be made up for you, and turned into the hashed form some containers want,
  without it ever being written anywhere but the box you are filling in.
- Two services that share a password or folder, or name each other, are now noticed and kept
  in step once you confirm it is deliberate.
- Fixes: a stack no longer reports its own container as using a port it wants; a container
  name is recognised in any case; an icon address copied from GitHub's file page now works;
  and an update that has been installed is noticed at once rather than still looking pending.
###2026.08.21
- Stacks can now be started, stopped and restarted, and their settings edited as a form —
  the core stack management this plugin exists to provide.
- Several fixes to keep a hand-written compose file exactly as you wrote it when saving
  through the form: spacing, special characters and repeated setting names are now all
  preserved correctly, and a file StaXX cannot fully understand is left alone rather than
  partly rewritten.
- Saving is safer: a save based on stale information is refused, a save is written whole or
  not at all, and a stack folder that turns out to be a shortcut to another location is never
  listed or touched.
- Closed off a couple of ways a hostile Docker image or icon source could have reached beyond
  its own container.
###2026.08.09
- Pre-alpha scaffold. Installs the Stacks page and reports environment readiness.
- No stack management yet.
</CHANGES>

<!--
  Minimum Unraid version is 7.2.0: the responsive WebGUI landed there and this
  plugin's markup targets it. Older releases are deliberately unsupported.
-->

<!--
  The package itself.
-->
<FILE Name="&pluginLOC;/&packageFile;" Run="upgradepkg --install-new --reinstall">
<URL>&packageURL;</URL>
<!-- Unraid prefers SHA256 when both are present; MD5 stays as the fallback for older releases. -->
<MD5>&packageMD5;</MD5>
<SHA256>&packageSHA256;</SHA256>
</FILE>

<!--
  Post-install. Seeds the persistent config from the shipped defaults without
  clobbering an existing one, then projects it onto the marker files the .page
  Cond expressions read.
-->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
set -euo pipefail

# Carry a pre-rename install across. The app was called stack.manager until
# 2026-08-18 and kept its settings, folder layout and stacks under that name.
# mv rather than cp: two config folders that both look valid is worse than one,
# and flash writes are the thing worth being stingy with on Unraid. The
# "new does not exist" guard is what makes a second install a no-op instead of
# a clobber. STACK_ROOT holds an absolute path, so it has to be rewritten or it
# points at a folder that no longer exists — and that folder is where the
# user's stacks are.
if [[ -d "/boot/config/plugins/stack.manager" && ! -d "/boot/config/plugins/staxx" ]]; then
  mv "/boot/config/plugins/stack.manager" "/boot/config/plugins/staxx"
  if [[ -f "/boot/config/plugins/staxx/stack.manager.cfg" ]]; then
    mv "/boot/config/plugins/staxx/stack.manager.cfg" "/boot/config/plugins/staxx/staxx.cfg"
  fi
  sed -i 's#/boot/config/plugins/stack\.manager#/boot/config/plugins/staxx#g' \
    "/boot/config/plugins/staxx/staxx.cfg" 2>/dev/null || true
fi
rm -rf "/usr/local/emhttp/plugins/stack.manager"   # stale tree; rebuilt at boot anyway
rm -rf "/tmp/stack.manager"                        # a cache, regenerates

mkdir -p "/boot/config/plugins/staxx"

# First install only — never overwrite a config the user has edited. New keys
# added in later versions are picked up from default.cfg at read time.
if [[ ! -f "/boot/config/plugins/staxx/staxx.cfg" ]]; then
  cp "/usr/local/emhttp/plugins/staxx/default.cfg" \
     "/boot/config/plugins/staxx/staxx.cfg"
fi

# Unconditional (not just on first install): the file holds a Docker Hub access
# token, so it must not be readable by any other login on the box.
chmod 0600 "/boot/config/plugins/staxx/staxx.cfg" 2>/dev/null || true

chmod +x /usr/local/emhttp/plugins/staxx/scripts/* 2>/dev/null || true

# Non-fatal on purpose: this is the one call in this block that must not trip
# set -e. A settings script hiccup here is recoverable at the next settings
# save or reboot, and should not be reported as a failed plugin install.
/usr/local/emhttp/plugins/staxx/scripts/apply_settings \
  || echo "warning: settings could not be applied yet; they will be applied on the next settings save or reboot."

echo ""
echo "-----------------------------------------------------------"
echo " StaXX has been installed."
echo " Stack management is up and running. Still pre-alpha — expect rough edges."
echo "-----------------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>

<!--
  Housekeeping: drop older package files left on the flash device.
-->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
# The package name is written out in full rather than as &packageFile;: this is
# a CDATA block, where XML does not expand an entity reference, so the entity
# would reach the shell literally, match nothing, and delete the package that
# was just installed. It has to be bumped by hand at every release.
find /boot/config/plugins/staxx -name 'staxx-*.txz' \
  ! -name "staxx-2026.08.26-noarch-1.txz" -delete 2>/dev/null || true
find /boot/config/plugins/staxx -name 'stack.manager-*.txz' -delete 2>/dev/null || true
]]>
</INLINE>
</FILE>

<!--
  Removal. The user's config and stacks are left alone on purpose: uninstalling
  a manager should not delete the things it managed. Removing them is a manual,
  deliberate act.
-->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
# Globbed against /var/log/packages, not the current directory — which is
# unspecified for a plugin script, so an unquoted glob here found nothing to
# remove, removepkg does no globbing of its own, and the rm -rf below then
# made removal look complete while a stale record stayed in the package
# database, confusing a later upgradepkg.
removepkg /var/log/packages/staxx-* 2>/dev/null || true
removepkg /var/log/packages/stack.manager-* 2>/dev/null || true   # a pre-rename install
rm -rf "/usr/local/emhttp/plugins/staxx"
rm -f  "/boot/config/plugins/staxx/"*.txz

# Unraid's cron builder concatenates every *.cron file under a plugin's own folder
# on the flash drive into root's crontab, so leaving ours behind keeps the server
# scheduling passes whose scripts have just been deleted.
rm -f "/boot/config/plugins/staxx/staxx.cron"
if [[ -x /usr/local/sbin/update_cron ]]; then /usr/local/sbin/update_cron || true; fi

# Only ever undo a sign-in this plugin performed — never an administrator's own
# Docker Hub session from outside StaXX.
if [[ -f "/boot/config/plugins/staxx/hub_login" ]]; then
  docker logout >/dev/null 2>&1 || true
  rm -f "/boot/config/plugins/staxx/hub_login"
fi

rm -rf "/tmp/staxx"   # job logs, stats snapshots, icon cache — all regenerate

echo ""
echo "-----------------------------------------------------------"
echo " StaXX has been removed."
echo " Your configuration and stack definitions were kept at:"
echo "   /boot/config/plugins/staxx"
echo "-----------------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>

</PLUGIN>
